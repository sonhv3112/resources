<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GpmLite.App.ViewModels"
             x:Class="GpmLite.App.Views.ExtensionsView"
             x:DataType="vm:ExtensionsViewModel">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
      <TextBlock Classes="h1" Text="Tiện ích mở rộng" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Classes="ghost" Content="⟳ Làm mới" Command="{Binding RefreshCommand}" />
        <Button Classes="primary" Content="Mở thư mục tiện ích" Command="{Binding OpenFolderCommand}" />
      </StackPanel>
    </Grid>
    <Border DockPanel.Dock="Top" Classes="card" Padding="14" Margin="0,0,0,10">
      <StackPanel Spacing="4">
        <TextBlock TextWrapping="Wrap"
                   Text="Chép mỗi tiện ích (dạng thư mục đã giải nén, có manifest.json) vào thư mục bên dưới. Tiện ích sẽ được nạp vào mọi hồ sơ ở lần mở tiếp theo." />
        <SelectableTextBlock Classes="muted" FontSize="12" Text="{Binding Folder}" FontFamily="Menlo,Consolas,monospace" />
      </StackPanel>
    </Border>
    <Border Classes="card" ClipToBounds="True">
      <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="*" x:DataType="vm:ExtensionRow" />
          <DataGridTextColumn Header="Thư mục" Binding="{Binding Folder}" Width="2*" x:DataType="vm:ExtensionRow" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </DockPanel>
</UserControl>
