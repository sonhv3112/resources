<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GpmLite.App.ViewModels"
             x:Class="GpmLite.App.Views.ProfilesView"
             x:DataType="vm:ProfilesViewModel">
  <DockPanel>
    <!-- Header -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Classes="h1" Text="Danh sách hồ sơ" />
        <TextBlock Classes="muted" FontSize="12" Text="{Binding Summary}" />
      </StackPanel>
      <WrapPanel Grid.Column="1" Classes="toolbar" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,-8">
        <Button Classes="ghost" Content="⊞ Mở xếp lưới" Command="{Binding OpenTiledCommand}" />
        <Button Classes="ghost" Content="Khôi phục" Command="{Binding RestoreCommand}" />
        <Button Classes="ghost" Content="Nhập từ Excel/CSV" Command="{Binding ImportExcelCommand}" />
        <Button Classes="ghost" Content="Tạo hàng loạt" Command="{Binding BulkCreateCommand}" />
        <Button Classes="primary" Content="+  Tạo hồ sơ" Command="{Binding CreateCommand}" />
      </WrapPanel>
    </Grid>

    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Classes="card" Padding="12,10" Margin="0,0,0,10">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <ComboBox Width="190" ItemsSource="{Binding GroupFilter}" SelectedItem="{Binding SelectedGroup}" />
          <TextBox Grid.Column="1" Margin="8,0,8,0" MinWidth="120" Watermark="Tìm theo tên, ghi chú, proxy..." Text="{Binding SearchText}" />
          <Button Grid.Column="2" Classes="ghost" Content="⟳ Làm mới" Command="{Binding RefreshCommand}" IsVisible="{Binding !HasSelection}" />
        </Grid>
        <WrapPanel Classes="toolbar" IsVisible="{Binding HasSelection}" Margin="0,2,0,-8">
          <TextBlock VerticalAlignment="Center" Classes="muted" Margin="0,0,8,8">
            <Run Text="Đã chọn" /> <Run Text="{Binding SelectedCount}" FontWeight="SemiBold" />
          </TextBlock>
          <Button Classes="ghost" Content="▶ Mở" Command="{Binding StartSelectedCommand}" />
          <Button Classes="ghost" Content="⊞ Mở xếp lưới" Command="{Binding OpenTiledCommand}" />
          <Button Classes="ghost" Content="■ Đóng" Command="{Binding StopSelectedCommand}" />
          <Button Classes="ghost" Content="Chuyển nhóm" Command="{Binding MoveSelectedCommand}" />
          <Button Classes="ghost" Content="Đổi fingerprint" Command="{Binding RandomizeSelectedCommand}" />
          <Button Classes="ghost" Foreground="{StaticResource Danger}" Content="Xoá" Command="{Binding DeleteSelectedCommand}" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- Table -->
    <Border Classes="card" ClipToBounds="True">
      <Grid>
        <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserResizeColumns="True"
                  CanUserReorderColumns="False" HeadersVisibility="Column" SelectionMode="Extended"
                  IsReadOnly="True" HorizontalScrollBarVisibility="Auto">
          <DataGrid.Columns>
            <DataGridTemplateColumn Width="40">
              <DataGridTemplateColumn.Header>
                <CheckBox IsChecked="{Binding $parent[UserControl].((vm:ProfilesViewModel)DataContext).AllSelected}" />
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ProfileRow">
                  <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40" x:DataType="vm:ProfileRow" />
            <DataGridTemplateColumn Header="Tên hồ sơ" Width="2*" MinWidth="130" SortMemberPath="Name">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ProfileRow">
                  <StackPanel VerticalAlignment="Center" Margin="8,0">
                    <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource Success}" IsVisible="{Binding IsRunning}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Proxy" Width="2*" MinWidth="135">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ProfileRow">
                  <StackPanel VerticalAlignment="Center" Margin="8,0">
                    <TextBlock Text="{Binding ProxyDisplay}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ProxyStatus}" FontSize="11" Classes="muted" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="HĐH" Binding="{Binding OsText}" Width="85" x:DataType="vm:ProfileRow" />
            <DataGridTextColumn Header="Lần mở cuối" Binding="{Binding LastRun}" Width="120" x:DataType="vm:ProfileRow" />
            <DataGridTemplateColumn Header="Thao tác" Width="140">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ProfileRow">
                  <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="6,0">
                    <Button Classes="run" Classes.running="{Binding IsRunning}" Content="{Binding RunText}"
                            Command="{Binding ToggleRunCommand}" IsEnabled="{Binding !IsBusy}" />
                    <Button Classes="link" Content="⋯" FontSize="16">
                      <Button.Flyout>
                        <MenuFlyout>
                          <MenuItem Header="Sửa hồ sơ" Command="{Binding EditCommand}" />
                          <MenuItem Header="Nhân bản" Command="{Binding CloneCommand}" />
                          <MenuItem Header="Kiểm tra proxy" Command="{Binding CheckProxyCommand}" />
                          <MenuItem Header="Sao chép địa chỉ debug (Selenium/Puppeteer)" Command="{Binding CopyDebuggerCommand}"
                                    IsEnabled="{Binding IsRunning}" />
                          <Separator />
                          <MenuItem Header="Xuất cookie" Command="{Binding ExportCookieCommand}" />
                          <MenuItem Header="Nhập cookie" Command="{Binding ImportCookieCommand}" />
                          <MenuItem Header="Sao lưu" Command="{Binding BackupCommand}" />
                          <Separator />
                          <MenuItem Header="Xoá" Command="{Binding DeleteCommand}" />
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                    IsVisible="{Binding !Rows.Count}">
          <TextBlock Text="Chưa có hồ sơ nào" FontSize="16" FontWeight="Medium" HorizontalAlignment="Center" />
          <TextBlock Classes="muted" Text="Tạo hồ sơ đầu tiên để bắt đầu." HorizontalAlignment="Center" />
          <Button Classes="primary" Content="+  Tạo hồ sơ" Command="{Binding CreateCommand}" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
