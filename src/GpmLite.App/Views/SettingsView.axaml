<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GpmLite.App.ViewModels"
             xmlns:proxy="using:GpmLite.Core.Proxy"
             x:Class="GpmLite.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer>
    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="12">
      <TextBlock Classes="h1" Text="Cài đặt" />

      <Border Classes="card" Padding="18">
        <StackPanel>
          <TextBlock FontWeight="SemiBold" FontSize="15" Text="Trình duyệt (browser core)" />
          <TextBlock Classes="label" Text="Đường dẫn Chrome/Chromium (để trống = tự phát hiện)" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Text="{Binding BrowserPath}" Watermark="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" />
            <Button Grid.Column="1" Classes="ghost" Margin="8,0,0,0" Content="Chọn..." Command="{Binding BrowseCommand}" />
          </Grid>
          <TextBlock Classes="muted" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding Detected}" />
        </StackPanel>
      </Border>

      <Border Classes="card" Padding="18">
        <StackPanel>
          <TextBlock FontWeight="SemiBold" FontSize="15" Text="Engine Camoufox (Firefox antidetect)" />
          <CheckBox Margin="0,10,0,0" IsChecked="{Binding UseCamoufox}"
                    Content="Dùng Camoufox thay cho Chromium (áp dụng cho mọi hồ sơ)" />
          <StackPanel IsVisible="{Binding UseCamoufox}" Spacing="2" Margin="0,8,0,0">
            <TextBlock Classes="label" Text="Đường dẫn Camoufox (để trống = tự phát hiện bản cài/bundled)" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding CamoufoxPath}" Watermark="~/Library/Caches/camoufox/Camoufox.app" />
              <Button Grid.Column="1" Classes="ghost" Margin="8,0,0,0" Content="Chọn..." Command="{Binding BrowseCamoufoxCommand}" />
            </Grid>
            <TextBlock Classes="label" Margin="0,8,0,0" Text="Python (có cài package camoufox) — để trống = python3 trên PATH" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding PythonPath}" Watermark="/path/to/.camoufox-venv/bin/python" />
              <Button Grid.Column="1" Classes="ghost" Margin="8,0,0,0" Content="Chọn..." Command="{Binding BrowsePythonCommand}" />
            </Grid>
            <TextBlock Classes="label" Margin="0,8,0,0" Text="Sidecar camoufox_sidecar.py (để trống = tự phát hiện cạnh app)" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding SidecarPath}" Watermark="sidecar/camoufox_sidecar.py" />
              <Button Grid.Column="1" Classes="ghost" Margin="8,0,0,0" Content="Chọn..." Command="{Binding BrowseSidecarCommand}" />
            </Grid>
            <TextBlock Classes="muted" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding CamoufoxStatus}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card" Padding="18">
        <StackPanel>
          <TextBlock FontWeight="SemiBold" FontSize="15" Text="Proxy &amp; vị trí" />
          <CheckBox Margin="0,10,0,0" IsChecked="{Binding CheckProxyOnStart}"
                    Content="Kiểm tra IP trước khi mở hồ sơ (cần cho múi giờ / ngôn ngữ / vị trí tự động)" />
          <TextBlock Classes="label" Text="Dịch vụ tra cứu IP" />
          <ComboBox ItemsSource="{Binding CheckerServers}" SelectedItem="{Binding SelectedChecker}"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="proxy:CheckerServer">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Classes="label" Margin="0,8,0,0" Text="URL (chọn sẵn ở trên hoặc nhập tuỳ chỉnh)" />
          <TextBox Text="{Binding IpLookupUrl}" FontFamily="Menlo,Consolas,monospace" />
          <TextBlock Classes="muted" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                     Text="Chọn một dịch vụ dựng sẵn (ip-api.com, ipwho.is, ipapi.co) hoặc nhập URL riêng. URL tuỳ chỉnh được phân tích theo kiểu ip-api.com. Đây là dịch vụ bên ngoài duy nhất ứng dụng gọi tới." />
        </StackPanel>
      </Border>

      <Border Classes="card" Padding="18">
        <StackPanel>
          <TextBlock FontWeight="SemiBold" FontSize="15" Text="API cục bộ (tự động hoá)" />
          <CheckBox Margin="0,10,0,0" IsChecked="{Binding LocalApiEnabled}" Content="Bật API trên 127.0.0.1" />
          <TextBlock Classes="label" Text="Cổng" />
          <NumericUpDown Value="{Binding LocalApiPort}" Minimum="1024" Maximum="65535" Increment="1" FormatString="0" Width="160" HorizontalAlignment="Left" />
          <TextBlock Classes="muted" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                     Text="POST /api/v1/profiles/{id}/start trả về debugger_address để Selenium (debuggerAddress) hoặc Puppeteer/Playwright (connectOverCDP) điều khiển hồ sơ." />
        </StackPanel>
      </Border>

      <Border Classes="card" Padding="18">
        <StackPanel Spacing="6">
          <TextBlock FontWeight="SemiBold" FontSize="15" Text="Dữ liệu" />
          <SelectableTextBlock Classes="muted" FontSize="12" Text="{Binding DataFolder}" FontFamily="Menlo,Consolas,monospace" />
          <Button Classes="ghost" Content="Mở thư mục dữ liệu" Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <Button Classes="primary" Content="Lưu cài đặt" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Margin="0,4,0,20" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
